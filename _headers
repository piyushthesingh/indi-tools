# The vendored libraries (libheif, pdf.js, pdf-lib, qrcode, the PDF
# standard fonts) are several megabytes between them and their contents
# never change, so they are cached for a year. The splat matches
# subdirectories too, which is what standard_fonts/ needs.
#
# Deliberately NOT immutable. These filenames carry no content hash, so
# immutable would mean a browser that once cached a bad or truncated copy
# never checks again, and a reload cannot rescue it. Without it, normal
# visits still hit cache and only an explicit reload revalidates, which
# costs one cheap 304.
/assets/vendor/*
  Cache-Control: public, max-age=31536000

# Brand assets change rarely, and a stale one is cosmetic rather than
# broken, so a week is a fair trade. Not immutable, for the same reason
# the vendor rule is not: these names carry no content hash.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-32x32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/android-chrome-192x192.png
  Cache-Control: public, max-age=604800
/android-chrome-512x512.png
  Cache-Control: public, max-age=604800
/maskable-icon-512x512.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800
# The header logo is on every page, and it lives under /assets/ where the
# default is revalidate-always. Without this it costs a conditional
# request on every page view for a file that never changes.
/assets/logo-white.svg
  Cache-Control: public, max-age=604800

# The share image is fetched by link-preview crawlers, not by visitors,
# and those cache it themselves for a long time anyway.
/og-image.png
  Cache-Control: public, max-age=604800

# base.css, theme.js and the app scripts deliberately keep Cloudflare's
# default revalidation. Caching them for a day would mean a CSS fix takes
# a day to reach anyone who had already visited, and a 304 is cheap.
